<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Kontakty czytamy tylko po to, żeby przy uroczystości podpowiedzieć imię
        i wziąć datę urodzin. Ma to wyłącznie nowy wygląd — klasyczna aplikacja
        o kontakty nie prosi. Pytamy dopiero przy pierwszym szukaniu, a odmowa
        niczego nie psuje: zostaje systemowe okno wyboru kontaktu.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application>
        <!--
            Klasyczny ekran startowy zostaje w pakiecie, ale przestaje być tym, który
            uruchamia system. Plik w src/main nie jest ruszany — regułę scalania
            zapisujemy wyłącznie tutaj.
        -->
        <activity android:name=".MainActivity" tools:node="merge">
            <intent-filter tools:node="removeAll" />
        </activity>

        <activity
            android:name=".nowy.NowaActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.GrafikPracy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Widżety ekranu głównego. Ma je tylko nowy wygląd — klasyczna aplikacja
            nie zna ani tych klas, ani biblioteki Glance.
        -->
        <receiver
            android:name=".nowy.widzety.WidzetDzisReceiver"
            android:exported="false"
            android:label="@string/widzet_dzis_etykieta">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widzet_dzis" />
        </receiver>

        <receiver
            android:name=".nowy.widzety.WidzetDoStartuReceiver"
            android:exported="false"
            android:label="@string/widzet_do_startu_etykieta">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widzet_do_startu" />
        </receiver>

        <receiver
            android:name=".nowy.widzety.WidzetTydzienReceiver"
            android:exported="false"
            android:label="@string/widzet_tydzien_etykieta">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widzet_tydzien" />
        </receiver>
    </application>
</manifest>
